{% macro social_icon(name, cls='social-svg') %}
{% set key = (name | default('') | lower) %}
{% set path = _paths.get(key) %}
{% if path %}
<svg class="{{ cls }}" viewBox="0 0 24 24" fill="currentColor" role="img" aria-hidden="true" focusable="false"><path d="{{ path }}"/></svg>
{% else %}
<span class="social-fallback" aria-hidden="true">{{ (name | default('•'))[:2] }}</span>
{% endif %}
{% endmacro %}
