{% from "components/tech_pills.html.j2" import tech_pills %}
{% macro project_card(item) %}
<article class="card project-card{% if not item.image %} project-card-flat{% endif %}">
  {% if item.image %}
  <div class="card-thumb"><img src="{{ item.image | media_url }}" alt="{{ item.title }}" loading="lazy"></div>
  {% endif %}
  <div class="card-body">
    <div class="project-card-head">
      <h3 class="card-title">
        {% if item.url %}<a href="{{ item.url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
      </h3>
      {% if item.display_date %}<span class="card-date">{{ item.display_date }}</span>{% endif %}
    </div>
    {% if item.summary_html %}<div class="card-summary">{{ item.summary_html | safe }}</div>{% endif %}
    {% set techs = item.technologies | default(item.tags) %}
    {{ tech_pills(techs) }}
    <div class="link-row">
      {% for link in item.links %}<a class="link-btn" href="{{ link.url | media_url }}" rel="noopener">{{ link.label }}</a>{% endfor %}
      {% if item.github %}<a class="link-btn" href="{{ item.github | media_url }}" rel="noopener">GitHub</a>{% endif %}
    </div>
  </div>
</article>
{% endmacro %}
