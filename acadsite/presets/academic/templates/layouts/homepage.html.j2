{% extends "base.html.j2" %}
{% from "components/publication_item.html.j2" import publication_item %}
{% from "components/project_card.html.j2" import project_card %}
{% from "components/timeline_item.html.j2" import timeline_item %}
{% from "components/personal_card.html.j2" import personal_card %}
{% from "components/news_item.html.j2" import news_item %}
{% from "components/social_icon.html.j2" import social_icon %}
{% from "components/education_item.html.j2" import education_item %}

{% macro preview(section) %}
  {% set col = section.collection %}
  {% set type = col.type %}
  <section class="section section-wide" id="{{ col.slug }}">
    <div class="container">
      {% if section.eyebrow %}<p class="eyebrow">{{ section.eyebrow }}</p>{% endif %}
      <h2 class="heading">{{ section.title | default(col.label) }}</h2>

      {% if type == 'publication-list' %}
        <div class="pub-list">{% for item in section['items'] %}{{ publication_item(item) }}{% endfor %}</div>

      {% elif type in ['cards', 'grid'] %}
        <div class="card-grid">{% for item in section['items'] %}{{ project_card(item) }}{% endfor %}</div>

      {% elif type == 'markdown-sections' %}
        <div class="personal-grid">{% for item in section['items'] %}{{ personal_card(item) }}{% endfor %}</div>

      {% elif type == 'timeline' and section.mode == 'grouped_accordion' %}
        <div class="accordion-list">
          {% for group in section.preview_groups %}
          <details class="accordion-group"{% if group.expanded %} open{% endif %}>
            <summary class="accordion-summary">
              <span class="accordion-identity">
                {% if features.get('organization_logos', true) and group.logo %}
                <span class="accordion-logo"><img src="{{ group.logo | media_url }}" alt=""></span>
                {% elif features.get('organization_logos', true) and group.logo_initials %}
                <span class="accordion-logo accordion-logo-text" aria-hidden="true">{{ group.logo_initials }}</span>
                {% endif %}
                <span>
                  <strong>{{ group.label }}</strong>
                  {% if group.description %}<small>{{ group.description }}</small>{% endif %}
                </span>
              </span>
              <span class="accordion-mark" aria-hidden="true"></span>
            </summary>
            <div class="accordion-content timeline">
              {% for item in group['items'] %}{{ timeline_item(item) }}{% endfor %}
            </div>
          </details>
          {% endfor %}
        </div>

      {% elif type == 'timeline' %}
        {% set limit = section.limit | default(section['items'] | length) %}
        <div class="timeline">
          {% for item in section.all_items[:limit] %}{{ timeline_item(item, true) }}{% endfor %}
          {% if section.mode == 'expandable' and section.all_items | length > limit %}
          <div class="collapsible" data-collapsible hidden>
            {% for item in section.all_items[limit:] %}{{ timeline_item(item, true) }}{% endfor %}
          </div>
          {% endif %}
        </div>
        {% if section.mode == 'expandable' and section.all_items | length > limit %}
        <button class="see-more" type="button" data-see-more aria-expanded="false">
          <span data-see-more-label>Show more</span> <span class="chevron">⌄</span>
        </button>
        {% endif %}

      {% else %}
        <div class="card-grid">{% for item in section['items'] %}{{ project_card(item) }}{% endfor %}</div>
      {% endif %}

      {% if section.link_to_full_page and section.full_url %}
      <a class="view-all" href="{{ section.full_url }}">View all {{ (section.title | default(col.label)) | lower }} →</a>
      {% endif %}
    </div>
  </section>
{% endmacro %}

{% block content %}
{% set hero_sections = sections | selectattr('type', 'equalto', 'hero') | list %}
{% set hero = hero_sections | first %}
{% if hero %}{% set p = hero.profile %}{% endif %}
<div class="home-shell">
  {% if hero %}
  <section class="hero-section home-intro">
    <div class="container hero-grid">
      <aside class="hero-col home-profile" aria-label="Profile">
        {% if p.photo %}
        <div class="hero-photo"><img src="{{ p.photo | media_url }}" alt="{{ p.name }}"></div>
        {% else %}
        <div class="hero-photo hero-photo-fallback"><span>{{ (p.name | default(site.title))[:1] }}</span></div>
        {% endif %}
        <h1 class="hero-name">{{ p.name | default(site.title) }}</h1>
        {% if p.tagline %}<p class="hero-title">{{ p.tagline }}</p>{% endif %}
        {% if p.affiliation %}<p class="hero-affil">{{ p.affiliation }}</p>{% endif %}
        <div class="chip-row">
          {% if site.cv %}<a class="btn btn-primary" href="{{ site.cv | media_url }}">View CV</a>{% endif %}
          {% for link in p.links | default([]) %}
          <a class="chip" href="{{ link.url | media_url }}" title="{{ link.label }}" aria-label="{{ link.label }}"{% if link.icon in ['github','linkedin','telegram','google-scholar','orcid','twitter','x'] %} rel="noopener" target="_blank"{% endif %}>
            <span class="chip-glyph">{{ social_icon(link.icon | default(link.label)) }}</span>
            <span>{{ link.handle | default(link.label) }}</span>
          </a>
          {% endfor %}
        </div>
      </aside>
      <div class="hero-info">
        {% if p.about_html %}
        <div><p class="eyebrow">About</p><div class="prose hero-about">{{ p.about_html | safe }}</div></div>
        {% endif %}
        {% if p.research_interests %}
        <div>
          <p class="eyebrow">Research Interests</p>
          <ul class="pill-list" role="list">{% for t in p.research_interests %}<li class="pill">{{ t }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {% if hero.collection_items %}
        <div>
          <p class="eyebrow">Education</p>
          <div class="education-list">{% for item in hero.collection_items %}{{ education_item(item) }}{% endfor %}</div>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  <div class="home-rest">
  {% for section in sections if section.type != 'hero' %}

  {% if section.type == 'news' %}
  <section class="section section-wide" id="news">
    <div class="container">
      <p class="eyebrow">Recent</p>
      <h2 class="heading">{{ section.title | default('News') }}</h2>
      <ul class="news-list">{% for item in section['items'] %}{{ news_item(item) }}{% endfor %}</ul>
    </div>
  </section>

  {% elif section.type == 'collection_preview' %}
    {% if section.get('collection') %}{{ preview(section) }}{% endif %}

  {% elif section.type == 'markdown' %}
  <section class="section section-wide">
    <div class="container"><div class="prose">{{ section.html | safe }}</div></div>
  </section>
  {% endif %}

  {% endfor %}
  </div>
</div>
{% endblock %}
