{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Publication item",
  "type": "object",
  "required": ["title"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string" },
    "authors": { "type": "string" },
    "venue": { "type": "string" },
    "year": { "type": ["integer", "string"] },
    "doi": { "type": "string" },
    "pdf": { "type": "string" },
    "code": { "type": "string" },
    "bibtex": { "type": "string" },
    "selected": { "type": "boolean" },
    "links": { "type": "array" },
    "tags": { "type": "array" }
  }
}
