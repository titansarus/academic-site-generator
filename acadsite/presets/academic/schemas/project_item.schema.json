{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project item",
  "type": "object",
  "required": ["title"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "date": { "type": "string" },
    "technologies": { "type": "array" },
    "tags": { "type": "array" },
    "links": { "type": "array" },
    "github": { "type": "string" },
    "image": { "type": "string" },
    "featured": { "type": "boolean" }
  }
}
