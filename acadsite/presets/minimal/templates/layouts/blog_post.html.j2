{% extends "base.html.j2" %}
{% block content %}
<article class="page detail">
  <a class="back" href="{{ url(collection.slug) }}">← {{ collection.label | lower }}</a>
  <h1 class="detail-h">{{ item.title }}</h1>
  <p class="detail-meta">{% if item.display_date %}{{ item.display_date }}{% endif %}{% if item.tags %} · {{ item.tags | join(', ') }}{% endif %}</p>
  {% if item.summary_html %}<div class="prose lead">{{ item.summary_html | safe }}</div>{% endif %}
  {% if item.body_html %}<div class="prose">{{ item.body_html | safe }}</div>{% endif %}
</article>
{% endblock %}
